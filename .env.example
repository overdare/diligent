# Copy to .env.local and configure at least one provider, or use stored credentials.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ZAI_CODING_PLAN_API_KEY=
GEMINI_API_KEY=

# Optional storage namespace (default: diligent).
# DILIGENT_STORAGE_NAMESPACE=diligent
# Optional release environment (default: prod).
# DILIGENT_ENV=dev
# Optional path to ripgrep (default: rg on PATH).
# DILIGENT_RG_PATH=/usr/local/bin/rg

# Optional provider diagnostics (disabled by default).
# ANTHROPIC_DEBUG_REQUEST=1
# DILIGENT_DEBUG_CHATGPT_WEBSOCKET=1
# DILIGENT_DEBUG_CHATGPT_HTTP_SSE=1

# Optional TUI tuning.
# DILIGENT_TUI_MAX_FPS=30
# DILIGENT_TUI_STREAM_BATCH_MS=16

# Optional live E2E tests (also require provider credentials).
# DILIGENT_RUN_LIVE_E2E=1
# DILIGENT_E2E_MODEL=your-provider-model
